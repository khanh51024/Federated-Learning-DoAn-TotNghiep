# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text file formats
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.csv text eol=lf
*.ipynb text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pt binary
*.pth binary
*.zip binary

# Preserve exact source bytes (CRLF/LF) for snapshot integrity
* -text
