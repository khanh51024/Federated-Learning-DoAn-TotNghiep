# Cấu hình môi trường cho Federated Learning & Web Dashboard.
# Các biến dưới đây là những biến mà web/ và src/ thực sự đọc (grep os.environ).

# --- Đường dẫn dữ liệu ---
PLANTVILLAGE_DATASET_ROOT=../PlantVillage-Dataset/raw/color
DATASET_ROOT=
PARTITION_DIR=data/partitions_stage2_scratch_v3/label100
ARTIFACTS_DIR=artifacts

# --- Web server ---
PORT=8088

# --- BẮT BUỘC TRƯỚC KHI MỞ WEB RA NGOÀI LOOPBACK (uvicorn --host 0.0.0.0) ---
# API huấn luyện (đăng/bật/tắt job) chỉ mở khi chưa đặt COMMUNITY_ADMIN_TOKEN cho kết nối
# được nhìn thấy là từ chính máy này (127.0.0.1/::1); request từ IP khác nhận 503.
# CẢNH BÁO reverse proxy: việc "từ máy này" đọc request.client.host, chỉ đúng khi uvicorn chạy
# kèm --proxy-headers --forwarded-allow-ips 127.0.0.1 (deploy/cropfed-demo.service đã đặt).
# Thiếu --proxy-headers thì mọi request đều hiện ra là IP của proxy và bị coi là cục bộ.
COMMUNITY_ADMIN_TOKEN=
COMMUNITY_ADMIN_USER=admin
# Khóa ký HMAC cho token participant và join code lưu trong SQLite cộng đồng.
# Bắt buộc, dài tối thiểu 12 ký tự. Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(32))"
COMMUNITY_SECRET=
COMMUNITY_STATE_DIR=artifacts/community_fl
# Hệ số hạn mức rate-limit cho lớp học/NAT cùng IP (0.1 -> 10).
COMMUNITY_RATE_SCALE=1
# Danh sách origin được phép CORS, phân tách bằng dấu phẩy; để trống = tắt CORS.
CORS_ALLOW_ORIGINS=

# --- Chặn trần tham số huấn luyện qua web ---
TRAIN_MAX_CENTRALIZED_EPOCHS=10
TRAIN_MAX_ROUNDS=10
TRAIN_MAX_LOCAL_EPOCHS=3
TRAIN_MAX_SECONDS=900
TRAIN_STARTS_PER_10_MIN=6
TRAIN_MIN_AVAILABLE_MB=500
TRAIN_MIN_AVAILABLE_MB_NETWORK=1400

# --- Flower (chỉ là giá trị tham khảo; launcher PowerShell tự truyền tham số,
#     hiện chưa có mã nào trong repo đọc bốn biến này) ---
FL_SERVER_HOST=127.0.0.1
FL_SERVER_PORT=8089
FL_NUM_CLIENTS=5
FL_ROUNDS=10
