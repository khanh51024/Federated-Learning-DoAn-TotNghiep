@echo off
chcp 65001 >nul
rem Tải từ trang Đo qua mạng. Tự tải gói client (có sẵn Python), kiểm mã băm, giải nén vào thư mục của tài khoản này rồi cài nút mở client.
rem Không cần quyền quản trị. Muốn gỡ: chạy GO_NUT_WEB.bat trong thư mục cài rồi xóa thư mục đó.
rem Cài xong máy tự nối với trang web, cả sau khi bật lại máy, và tự mở client khi quản trị viên chọn máy này cho một lần đo.
set "URL=@@BASE@@/api/flower/client-package/file"
set "SHA=@@SHA256@@"
set "DIR=%LOCALAPPDATA%\CropFedClient"
set "ZIP=%DIR%\goi_@@SHORT@@.zip"
rem Gọi đúng bản của Windows: máy có cài Git có thể có tar khác đứng trước trong PATH, bản đó không đọc được zip.
set "CURL=%SystemRoot%\System32\curl.exe"
set "TAR=%SystemRoot%\System32\tar.exe"
set "CERTUTIL=%SystemRoot%\System32\certutil.exe"
set "CROPFED_WEB=@@BASE@@"

if not exist "%CURL%" goto :old_windows
if not exist "%TAR%" goto :old_windows

if defined DEMO_FORCE goto :go
reg query "HKCU\Software\Classes\cropfed-demo\shell\open\command" /ve 2>nul | findstr /i /c:"deploy\lan_client" >nul
if not errorlevel 1 (
  echo Máy này đã cài client từ thư mục dự án. Chạy lại deploy\lan_client\CAI_NUT_WEB.bat để máy tự nối với trang web.
  goto :end
)

:go
if not exist "%DIR%" mkdir "%DIR%"
if not exist "%ZIP%" goto :download
"%CERTUTIL%" -hashfile "%ZIP%" SHA256 | findstr /i /x "%SHA%" >nul
if errorlevel 1 goto :download
echo [1/3] Gói đã tải đủ từ lần trước.
goto :extract

:download
echo [1/3] Tải gói client, khoảng @@SIZE_MB@@ MB. Mất điện hoặc rớt mạng thì chạy lại file này, tải tiếp từ chỗ đang dở.
"%CURL%" -fL --retry 3 --retry-delay 3 -C - -o "%ZIP%" "%URL%"
if errorlevel 1 (
  rem Mã 22: máy chủ từ chối, thường do tệp dở không còn tải tiếp được. Xóa để lần sau tải lại từ đầu.
  if errorlevel 22 if not errorlevel 23 del "%ZIP%" >nul 2>nul
  echo [LỖI] Không tải được gói client. Kiểm tra mạng rồi chạy lại file này.
  goto :fail
)

echo [2/3] Kiểm tra mã băm của gói...
"%CERTUTIL%" -hashfile "%ZIP%" SHA256 | findstr /i /x "%SHA%" >nul
if errorlevel 1 (
  echo [LỖI] Gói tải về không khớp mã băm, đã xóa. Chạy lại file này. Nếu vẫn lỗi, tải lại file cài từ trang web.
  del "%ZIP%"
  goto :fail
)

:extract
echo [3/3] Giải nén, khoảng 1 đến 3 phút...
rem Bản cài cũ đang chạy nền thì giữ tệp trong thư mục app: dừng hẳn trước khi xóa.
if exist "%DIR%\app\client_agent.py" "%DIR%\app\python\python.exe" "%DIR%\app\client_agent.py" --stop
if errorlevel 1 (
  echo [LỖI] Không dừng được bản đang chạy. Khởi động lại máy rồi chạy lại file này.
  goto :fail
)
if exist "%DIR%\app" rd /s /q "%DIR%\app"
mkdir "%DIR%\app"
"%TAR%" -xf "%ZIP%" -C "%DIR%\app"
if errorlevel 1 (
  echo [LỖI] Không giải nén được. Kiểm tra ổ đĩa còn trống ít nhất 2 GB rồi chạy lại file này.
  goto :fail
)
del "%ZIP%"

set DEMO_NOPAUSE=1
call "%DIR%\app\CAI_NUT_WEB.bat"
if errorlevel 1 goto :fail
echo.
echo XONG. Quay lại trang web, máy này sẽ hiện ở mục Máy đã cài bộ client sau vài giây.

:end
echo Bấm phím bất kỳ để đóng...
pause >nul
exit /b 0

:old_windows
echo [LỖI] Bản Windows này chưa có curl hoặc tar. Cần Windows 10 bản 1803 trở lên.
:fail
echo Bấm phím bất kỳ để đóng...
pause >nul
exit /b 1
